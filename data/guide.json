    },
    {
      "id": "lost-passport-steps",
      "category": "緊急時",
      "title_ja": "パスポートを失くしたときの順番",
      "body_ja": "まずre:Inventのヘルプデスク、会場のセキュリティ、日本語ツアーデスクに連絡し、落とし物窓口へ問い合わせる。見つからなければ警察の届出と、ロサンゼルスでの渡航書手続き。用意するもの：紛失届、写真45×35mm、航空券確認書、ESTA控え、戸籍謄本など。",
      "year": 2025,
      "sources": [
        "https://blog.serverworks.co.jp/lost-passport-at-las-vegas",
        "https://dev.classmethod.jp/articles/reinvent2017-report-what-do-you-do-if-you-lost-your-id/"
      ]
    },
    {
      "id": "lost-passport-prep",
      "category": "緊急時",
      "title_ja": "紛失に備えて書類を別に持つ",
      "body_ja": "パスポートの写真ページのコピー、ESTA控え、航空券、証明写真を別の場所に保管する。陸路でロサンゼルスまで約6時間かかる見込みで、国内線にはパスポートが要る。",
      "year": 2025,
      "sources": [
        "https://blog.serverworks.co.jp/lost-passport-at-las-vegas"
      ]
    },
    {
      "id": "us-911",
